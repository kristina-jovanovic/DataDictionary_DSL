DATA DICTIONARY
id: 1
name: "Попис инвентара"
author: "КЈ"
version: "2"
date of creation: 25.07.2026.
{
    LOGICAL FUNCTION
    id: 1
    name: "IsValidDate"
    definition: <= today
    result: true

    SEMANTIC DOMAIN
    id: 1
    name: "Количина"
    base: Integer
    constraint: > 0

    STRUCTURES
    id: 1
    name: "ПописИнвентара"
    type: dataStore
    <
        id: 1
        name: "Организација"
        &
            domain: String
            nullability: not null
        &

        id: 2
        name: "Адреса"
        &
            domain: String
            nullability: not null
        &

        id: 3
        name: "Инвентар"
        #
            type: dataStore
            <
                id: 4
                name: "ЛистаИнвентара"
                #
                    type: dataStore
                    {
                        id: 5
                        name: "Број"
                        &
                            domain: Integer
                            constraint: > 0
                        &

                        id: 6
                        name: "Назив"
                        &
                            domain: String
                            nullability: not null
                        &

                        id: 7
                        name: "Количина"
                        &
                            domain: "Количина"
                            nullability: not null
                        &

                        id: 8
                        name: "ЦенаПоКомаду"
                        &
                            domain: Real
                            constraint: > 0
                        &

                        id: 9
                        name: "УкупнаЦена"
                        &
                            domain: Real  
                            constraint: = "ЦенаПоКомаду" * "Количина"
                        &
                    }
                #

                id: 10
                name: "УкупнаВредност"
                &
                    domain: Real
                    nullability: not null
                    constraint:  = SUM("УкупнаЦена")
                &
            >
        #

        id: 11
        name: "Испорука"
        #
            type: dataStore
            /
                id: 12
                name: "Лично"
                &
                    domain: Logical
                &

                id: 13
                name: "ПутемЕПоште"
                &
                    domain: Logical
                &

                id: 14
                name: "ПутемПоште"
                &
                    domain: Logical
                &

                id: 15
                name: "ПутемИнтерногСистема"
                &
                    domain: Logical
                &
            /
        #

        id: 16
        name: "Припремио"
        #
            type: dataStore
            <
                id: 17
                name: "ИмеИПрезиме"
                &
                    domain: String
                    nullability: not null
                &

                id: 18
                name: "Телефон"
                &
                    domain: String
                    nullability: not null
                &

                id: 19
                name: "ЕПошта"
                &
                    domain: String
		            format: "LIKE %@%.%"
                    nullability: not null
                &

                id: 20
                name: "Датум"
                &
                    domain: Date
                    nullability: not null
                    constraint: <= today
                &
            >
        #
    >
}