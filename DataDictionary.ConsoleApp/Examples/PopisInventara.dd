DATA DICTIONARY
id: 1
name: "Попис инвентара"
author: "КЈ"
version: "2"
date of creation: 25.07.2026.
{
    LOGICAL FUNCTION
    id: 1
    name: "IsValidDate"
    definition: <= today
    result: true

    SEMANTIC DOMAIN
    id: 1
    name: "ДКоличина"
    base: Integer
    constraint: > 0

    STRUCTURES
    id: 1
    name: "Попис инвентара"
    type: dataStore
    <
        id: 2
        name: "Организација"
        &
            domain: String
            nullability: not null
        &

        id: 3
        name: "Адреса"
        &
            domain: String
            nullability: not null
        &

        id: 4
        name: "Листа инвентара"
        #
            type: dataStore
            <
                id: 5
                name: "Ставка листе"
                #
                    type: dataStore
                    {
                        id: 6
                        name: "Број"
                        &
                            domain: Integer
                            constraint: > 0
                        &

                        id: 7
                        name: "Назив"
                        &
                            domain: String
                            nullability: not null
                        &

                        id: 8
                        name: "Количина"
                        &
                            domain: "ДКоличина"
                            nullability: not null
                        &

                        id: 9
                        name: "Цена по комаду"
                        &
                            domain: Real
                            constraint: > 0
                        &

                        id: 10
                        name: "Укупна цена"
                        &
                            domain: Real  
                            constraint: = "Количина" * "Цена по комаду"
                        &
                    }
                #

                id: 11
                name: "Укупна вредност"
                &
                    domain: Real
                    nullability: not null
                    constraint:  = SUM("Укупна цена")
                &
            >
        #

        id: 12
        name: "Испорука"
        #
            type: dataStore
            /
                id: 13
                name: "Лично"
                &
                    domain: Logical
                &

                id: 14
                name: "Путем е-поште"
                &
                    domain: Logical
                &

                id: 15
                name: "Путем поште"
                &
                    domain: Logical
                &

                id: 16
                name: "Путем интерног система"
                &
                    domain: Logical
                &
            /
        #

        id: 17
        name: "Припремио"
        #
            type: dataStore
            <
                id: 18
                name: "Име и презиме"
                &
                    domain: String
		            format: "^([А-Ш][а-ш]+\s*)+$"
                    nullability: not null
                &

                id: 19
                name: "Телефон"
                &
                    domain: String
		            format: "^(\+3816)[0-9]{7,9}$"
                    nullability: not null
                &

                id: 20
                name: "Е пошта"
                &
                    domain: String
                    nullability: not null
		            constraint: LIKE "%@%.%"
                &

                id: 21
                name: "Датум"
                &
                    domain: Date
		            format: "dd.MM.yyyy."
                    nullability: not null
                    constraint: <= today
                &
            >
        #
    >
}