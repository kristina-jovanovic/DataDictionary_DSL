{
  "type": "Panel",
  "id": 1,
  "name": "РезервацијаАвиоКарата",
  "title": "Резервација авио карата",
  "layout": {
    "type": "Flow"
  },
  "controls": [
    {
      "type": "TextBox",
      "id": 2,
      "name": "БројРезервације",
      "pattern": "^[A-Z]{2}-\\d{4}-\\d{4}$",
      "dataType": "String",
      "label": "Број резервације",
      "isRequired": true
    },
    {
      "type": "DateTimePicker",
      "id": 3,
      "name": "ДатумРезервације",
      "format": "dd.MM.yyyy.",
      "dataType": "Date",
      "label": "Датум резервације",
      "isRequired": true
    },
    {
      "type": "TextBox",
      "id": 4,
      "name": "СтатусРезервације",
      "dataType": "String",
      "label": "Статус резервације",
      "isRequired": true,
      "restrictedValue": {
        "rules": [
          {
            "targetName": "СтатусРезервације",
            "operator": "IN",
            "value": [
              {
                "value": "потврђена"
              },
              {
                "value": "непотврђена"
              },
              {
                "value": "отказана"
              }
            ]
          }
        ]
      }
    },
    {
      "type": "Panel",
      "id": 5,
      "name": "ПодациОПутнику",
      "title": "Подаци о путнику",
      "layout": {
        "type": "Flow"
      },
      "controls": [
        {
          "type": "TextBox",
          "id": 6,
          "name": "ИмеИПрезиме",
          "pattern": "^([А-Ш][а-ш]+\\s*)+$",
          "dataType": "String",
          "label": "Име и презиме",
          "isRequired": true
        },
        {
          "type": "TextBox",
          "id": 7,
          "name": "БројПасоша",
          "pattern": "^[0-9]{7}$",
          "dataType": "String",
          "label": "Број пасоша",
          "isRequired": true
        },
        {
          "type": "TextBox",
          "id": 8,
          "name": "Држављанство",
          "dataType": "String",
          "label": "Држављанство",
          "isRequired": true
        }
      ]
    },
    {
      "type": "Collection",
      "id": 9,
      "name": "СтавкаРезервације",
      "template": {
        "type": "Panel",
        "id": 10,
        "name": "СтавкаРезервације",
        "title": "Ставка резервације",
        "layout": {
          "type": "Grid",
          "showGridLines": true
        },
        "controls": [
          {
            "type": "TextBox",
            "id": 11,
            "name": "Лет",
            "pattern": "^[A-Z0-9]{2}\\d{1,4}[A-Z]?$",
            "dataType": "String",
            "label": "Лет",
            "isRequired": true
          },
          {
            "type": "TextBox",
            "id": 12,
            "name": "Полазак",
            "dataType": "String",
            "label": "Полазак",
            "isRequired": true
          },
          {
            "type": "TextBox",
            "id": 13,
            "name": "Долазак",
            "dataType": "String",
            "label": "Долазак",
            "isRequired": true
          },
          {
            "type": "DateTimePicker",
            "id": 14,
            "name": "Датум",
            "format": "dd.MM.yyyy.",
            "dataType": "Date",
            "label": "Датум",
            "isRequired": true
          },
          {
            "type": "DateTimePicker",
            "id": 15,
            "name": "Време",
            "format": "HH:mm",
            "dataType": "Date",
            "label": "Време",
            "isRequired": true
          },
          {
            "type": "TextBox",
            "id": 16,
            "name": "Седиште",
            "pattern": "^[1-9][0-9]*[ A-HJ-K]$",
            "dataType": "String",
            "label": "Седиште"
          },
          {
            "type": "TextBox",
            "id": 17,
            "name": "ЦенаКарте",
            "dataType": "Integer",
            "label": "Цена карте",
            "isRequired": true,
            "restrictedValue": {
              "rules": [
                {
                  "targetName": "СтавкаРезервације.ЦенаКарте",
                  "operator": ">=",
                  "value": 0
                }
              ]
            }
          }
        ]
      }
    },
    {
      "type": "Panel",
      "id": 18,
      "name": "ДодатнеУслуге",
      "title": "Додатне услуге",
      "layout": {
        "type": "Flow"
      },
      "controls": [
        {
          "type": "CheckBox",
          "id": 19,
          "name": "Изабрано",
          "groupName": "Додатне услуге",
          "optionValue": "Изабрано",
          "dataType": "Logical",
          "label": "Изабрано",
          "isRequired": true
        },
        {
          "type": "TextBox",
          "id": 20,
          "name": "Назив",
          "dataType": "String",
          "label": "Назив",
          "isRequired": true
        },
        {
          "type": "TextBox",
          "id": 21,
          "name": "ЦенаУслуге",
          "dataType": "Integer",
          "label": "Цена услуге",
          "isRequired": true,
          "restrictedValue": {
            "rules": [
              {
                "targetName": "ЦенаУслуге",
                "operator": ">",
                "value": 0
              }
            ]
          }
        }
      ]
    },
    {
      "type": "Panel",
      "id": 22,
      "name": "Обрачун",
      "title": "Обрачун",
      "layout": {
        "type": "Flow"
      },
      "controls": [
        {
          "type": "TextBox",
          "id": 23,
          "name": "ЦенаКарата",
          "dataType": "Integer",
          "label": "Цена карата",
          "isRequired": true,
          "isReadOnly": true,
          "computedValue": {
            "rules": [
              {
                "operator": "SUM",
                "value": [
                  {
                    "targetName": "СтавкаРезервације.ЦенаКарте"
                  }
                ]
              }
            ]
          }
        },
        {
          "type": "TextBox",
          "id": 24,
          "name": "АеродромскеТаксе",
          "dataType": "Integer",
          "label": "Аеродромске таксе",
          "isRequired": true,
          "restrictedValue": {
            "rules": [
              {
                "targetName": "АеродромскеТаксе",
                "operator": ">=",
                "value": 0
              }
            ]
          }
        },
        {
          "type": "TextBox",
          "id": 25,
          "name": "ЦенаДодатнихУслуга",
          "dataType": "Integer",
          "label": "Цена додатних услуга",
          "isReadOnly": true,
          "computedValue": {
            "rules": [
              {
                "operator": "SUM",
                "value": [
                  {
                    "targetName": "ДодатнеУслуге.ЦенаУслуге"
                  }
                ]
              }
            ]
          }
        },
        {
          "type": "TextBox",
          "id": 26,
          "name": "УкупанИзносЗаПлаћање",
          "dataType": "Integer",
          "label": "Укупан износ за плаћање",
          "isRequired": true,
          "isReadOnly": true,
          "computedValue": {
            "rules": [
              {
                "operator": "+",
                "value": [
                  {
                    "operator": "+",
                    "value": [
                      {
                        "targetName": "ЦенаКарата"
                      },
                      {
                        "targetName": "АеродромскеТаксе"
                      }
                    ]
                  },
                  {
                    "targetName": "ЦенаДодатнихУслуга"
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  ]
}