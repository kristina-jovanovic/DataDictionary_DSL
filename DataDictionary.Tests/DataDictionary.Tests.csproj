<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tri studijska primera se LINKUJU iz ConsoleApp/Examples (jedan izvor istine)
         i kopiraju u izlazni folder testova, pa se citaju iz TestInputs u runtime-u. -->
    <Content Include="..\DataDictionary.ConsoleApp\Examples\PopisInventara.dd" Link="TestInputs\PopisInventara.dd" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\DataDictionary.ConsoleApp\Examples\IspitnaPrijava.dd" Link="TestInputs\IspitnaPrijava.dd" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\DataDictionary.ConsoleApp\Examples\RezervacijaAvioKarata.dd" Link="TestInputs\RezervacijaAvioKarata.dd" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cela cev: parser -> semantika -> transformacija -->
    <ProjectReference Include="..\DataDictionary.Parser\DataDictionary.Parser.csproj" />
    <ProjectReference Include="..\DataDictionary.Analysis\DataDictionary.Analysis.csproj" />
    <ProjectReference Include="..\DataDictionary.Transformation\DataDictionary.Transformation.csproj" />
  </ItemGroup>

</Project>